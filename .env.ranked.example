# Copy to .env.ranked.local. For Supabase-managed Google sign-in, fill these two values.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Direct Google sign-in also remains available with these two server-only credentials.
GOOGLE_RANKED_CLIENT_ID=
GOOGLE_RANKED_CLIENT_SECRET=
GOOGLE_RANKED_REDIRECT_URI=http://localhost:3001/api/online/auth/google/callback
COMPETITION_DB_PATH=build/ranked-local.sqlite
# On the hosted backend, use a private Postgres role scoped to server/ranked-postgres.sql.
# Set GOOGLE_RANKED_REDIRECT_URI to the hosted callback and allow it in Supabase Auth.
# Use the project CA PEM and a connection URL without SSL query parameters.
COMPETITION_DATABASE_URL=
COMPETITION_DATABASE_CA=
HOST=127.0.0.1
PORT=3001
