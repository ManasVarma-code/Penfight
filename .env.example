# GEMINI_API_KEY: Required only if Gemini AI API calls are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted URL of the web/PWA deployment.
APP_URL="MY_APP_URL"

# HTTPS origin of the multiplayer server for Android and Cloudflare Pages web hosting.
# For Cloudflare Pages, set this variable in Cloudflare Pages dashboard -> Settings -> Environment Variables.
# On your Render backend, ensure the Cloudflare Pages origin is included in ONLINE_ALLOWED_ORIGINS:
# e.g. ONLINE_ALLOWED_ORIGINS="https://your-site.pages.dev,http://localhost:3000"
# VITE_ONLINE_SERVER_URL="https://pen-fight-royale-matchmaking.onrender.com"

# ------------------------------------------------------------------
# GOOGLE ADSENSE CONFIGURATION — WEB / CLOUDFLARE PAGES ONLY
# Placed strictly outside active gameplay (desktop gutters / menu).
# Disabled by default until genuine publisher and slot IDs are provided.
# ------------------------------------------------------------------
VITE_ADSENSE_ENABLED="false"
VITE_ADSENSE_CLIENT_ID=""
VITE_ADSENSE_SLOT_DESKTOP_LEFT=""
VITE_ADSENSE_SLOT_DESKTOP_RIGHT=""
VITE_ADSENSE_SLOT_MENU_BOTTOM=""

# ------------------------------------------------------------------
# GOOGLE ADMOB CONFIGURATION — DEVELOPMENT / QA DEFAULTS
# Values below are OFFICIAL Google AdMob Test IDs (safe for dev & QA).
# Copy to `.env` for local development.
# For signed Play Store releases, create `.env.production` from
# `.env.production.example` and configure `ADMOB_APP_ID` in Gradle.
# ------------------------------------------------------------------
VITE_ADMOB_APP_ID="ca-app-pub-3940256099942544~3347511713"
VITE_ADMOB_REWARDED_ID="ca-app-pub-3940256099942544/5224354917"
VITE_ADMOB_INTERSTITIAL_ID="ca-app-pub-3940256099942544/1033173712"
VITE_ADMOB_BANNER_ID="ca-app-pub-3940256099942544/6300978111"

# Comma-separated hashed Android AdMob test device IDs (optional for device QA)
VITE_ADMOB_TESTING_DEVICES=""

# Bottom clearance in dp so menu Adaptive Banner clears Android 15/16 gesture bar
VITE_ADMOB_BANNER_BOTTOM_MARGIN="18"

# Keep "true" during development/QA. MUST be "false" for Play Store release builds.
VITE_ADMOB_TEST_MODE="true"

# Optional AdMob diagnostics in the local Vite dev server.
VITE_SHOW_PUBLISHER_CONSOLE="false"
